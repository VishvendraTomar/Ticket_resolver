# Copy to .env (repo root) and fill in. Never commit .env.
# In a Codespace / devcontainer, .devcontainer/post-create.sh writes .env for
# you with random local passwords if it doesn't exist yet.

# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database (Docker Compose: postgres = pg16 + pgvector) --------------------
# Read by compose.yaml to initialise the container. This superuser is the
# owner role: migrations and catalog tests only, never the running app.
POSTGRES_USER=owner
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ticket_resolver
# Password for the app's role, app_user (NOBYPASSRLS). Don't create the role
# by hand: `uv run alembic upgrade head` creates it with this password. Use a
# long random password of letters and digits (it's embedded in URLs below).
APP_DB_PASSWORD=CHANGE_ME_LONG_RANDOM
# Connection URLs, built from the values above (${VAR} is expanded by the API,
# Docker Compose and Next.js alike). Compose rebuilds them with host
# `postgres` for its containers; these are for processes on the host.
# Owner role: migrations and catalog tests only, never the running app.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# The app (user must be app_user):
APP_DATABASE_URL=postgresql://app_user:${APP_DB_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Tests only: 1 makes pytest fail (instead of skip the DB/RLS tests) when the
# two URLs above are missing. CI sets it; leave unset locally.
# REQUIRE_DB_TESTS=1

# --- Jobs (ADR-0007) -------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
# true = run ingestion tasks inline in the API process (no worker). local/test only.
CELERY_TASK_ALWAYS_EAGER=false

# --- Knowledge base: storage, parsing (docs/failure-modes/ingestion.md, parsing.md) --
# memory (tests) | local (dev) | gcs (staging/production; must be an EU bucket)
STORAGE_PROVIDER=local
# Used when STORAGE_PROVIDER=local. Default: <repo>/data/uploads
STORAGE_LOCAL_DIR=
GCS_BUCKET=
# For fake-gcs-server only (google-cloud-storage reads it directly):
# STORAGE_EMULATOR_HOST=http://localhost:4443
# docling (default) | fake (tests)
PARSER_PROVIDER=docling
MAX_UPLOAD_MB=50
MAX_PAGES=300
PARSE_TIMEOUT_SECONDS=900
OCR_MIN_CONFIDENCE=0.7

# --- Vertex AI (ADR-0006). EU locations only; credentials via ADC --------------------
# Application Default Credentials: `gcloud auth application-default login`, or
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json (never commit it).
VERTEX_PROJECT=
# fake (default, offline) | vertex
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIMS=768
# gemini-embedding-001 is processed in the EU multi-region (no in-country option).
EMBEDDINGS_LOCATION=europe-west4
EMBEDDINGS_CONCURRENCY=8
EMBED_MAX_TOKENS=1800
# fake (default, offline) | vertex
LLM_PROVIDER=fake
# Newest Flash with in-country (Frankfurt) processing. gemini-3.8-flash is newer but
# EU-multi-region only: LLM_SMALL_MODEL=vertex_ai/gemini-3.8-flash with LLM_LOCATION=eu.
LLM_SMALL_MODEL=vertex_ai/gemini-3.5-flash
LLM_LOCATION=europe-west3
LLM_TIMEOUT_SECONDS=60
TAGGING_MAX_SECTIONS=200

# --- Auth (ADR-0003: Clerk for identity only) ----------------------------------
# fake | clerk   (fake is refused unless ENVIRONMENT is local or test)
AUTH_PROVIDER=clerk
# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Comma-separated origins allowed in the token's azp claim.
# Required (non-empty) when AUTH_PROVIDER=clerk outside local/test.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- Web app (web/, Next.js) --------------------------------------------------
# next.config.ts loads this repo-root .env. Only NEXT_PUBLIC_* values reach the
# browser, and they're inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Clerk publishable key (pk_test_… / pk_live_…). Leave empty to use the fake
# dev sign-in, which works only with AUTH_PROVIDER=fake on the API.
# With a key, also set AUTH_PROVIDER=clerk and CLERK_ISSUER above (the Frontend
# API URL shown next to the keys in the Clerk dashboard).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional override: clerk | fake (default: clerk if a key is set, else fake)
NEXT_PUBLIC_AUTH_PROVIDER=
# Clerk secret key (sk_…). Not used by M1 (the API verifies tokens via JWKS and
# the web app only uses Clerk client-side). Needed later for server-side Clerk
# calls and the user-deletion webhook. Secret: never commit it.
CLERK_SECRET_KEY=

# --- API ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Errors (optional; no-op when empty) ---------------------------------------
SENTRY_DSN=
