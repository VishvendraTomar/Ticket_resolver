# Copy to .env (repo root) and fill in. Never commit .env.

# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database (ADR-0001: Neon for now; Compose Postgres later) -----------------
# Owner role from the Neon dashboard (e.g. neondb_owner). Migrations + catalog
# tests only. Use the DIRECT endpoint (host without "-pooler"), on a dev branch.
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# The app's role. Do NOT create it in the Neon dashboard (those roles get
# BYPASSRLS via neon_superuser): `uv run alembic upgrade head` creates it with
# this password. Same host and database as DATABASE_URL; user must be app_user.
# Use a long random password (URL-encode special characters).
APP_DATABASE_URL=postgresql://app_user:CHANGE_ME_LONG_RANDOM@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Auth (ADR-0003: Clerk for identity only) ----------------------------------
# fake | clerk   (fake is refused unless ENVIRONMENT is local or test)
AUTH_PROVIDER=clerk
# Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Comma-separated origins allowed in the token's azp claim
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- API ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Errors (optional; no-op when empty) ---------------------------------------
SENTRY_DSN=
